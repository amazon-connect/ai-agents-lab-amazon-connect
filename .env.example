# OIDC Configuration
# These values are auto-populated by: ./scripts/deploy.sh env
# Or manually copy from CDK stack outputs after deployment.
VITE_OIDC_ISSUER_URL=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_CLIENT_SECRET=
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/oauth/callback
VITE_AWS_REGION=

# Dev bypass mode — skips real OIDC authentication for local development
# Set to "true" to use mock auth without a live Identity Provider
# For hosted deployment, deploy.sh sets this to false automatically.
VITE_AUTH_BYPASS=true
